{% if d.ospf %}
router ospf {{ d.ospf.pid }}
 router-id {{ d.ospf.router_id }}
 auto-cost reference-bandwidth {{ d.ospf.ref_bw }}
{% for p in d.ospf.passive %}
 passive-interface {{ p }}
{% endfor %}
{% for ip, wc, area in d.ospf.networks %}
 network {{ ip }} {{ wc }} area {{ area }}
{% endfor %}
{% for area, net, mask in d.ospf.summaries %}
 area {{ area }} range {{ net }} {{ mask }}
{% endfor %}
{% if d.ospf.redistribute_bgp %}
 redistribute bgp {{ d.ospf.redistribute_bgp }} subnets
{% endif %}
!
{% endif %}
